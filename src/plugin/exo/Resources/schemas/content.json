{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "base": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "meta": {
          "$ref": "http://json-quiz.github.io/json-quiz/schemas/metadata.json"
        }
      },
      "required": ["id", "type"]
    },
    "embedded": {
      "type": "object",
      "properties": {
        "encoding": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      },
      "required": ["data"]
    },
    "distant": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": ["url"]
    },
    "resource": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            }
          },
          "required": ["id", "slug"]
        }
      },
      "required": ["resource"]
    }
  },
  "allOf": [
    {
      "$ref": "http://json-quiz.github.io/json-quiz/schemas/content.json#/definitions/base"
    },
    {
      "oneOf": [
        {
          "$ref": "http://json-quiz.github.io/json-quiz/schemas/content.json#/definitions/embedded"
        },
        {
          "$ref": "http://json-quiz.github.io/json-quiz/schemas/content.json#/definitions/distant"
        },
        {
          "$ref": "http://json-quiz.github.io/json-quiz/schemas/content.json#/definitions/resource"
        }
      ]
    }
  ]
}
