{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The uuid of the page"
    },
    "slug": {
      "type": "string",
      "description": "The slug of the page"
    },
    "title": {
      "type": "string",
      "description": "The title of the page"
    },
    "poster": {
      "type": ["string", "null"],
      "description": "An image Url for the page's poster"
    },
    "text": {
      "type": ["string", "null"],
      "description": "The text of the page"
    },
    "internalNote": {
      "type": ["string", "null"],
      "description": "A text only visible by users with the correct right"
    },
    "parentSlug": {
      "type": "string",
      "description": "The slug of the page's parent"
    },
    "previousSlug": {
      "type": ["string", "null"],
      "description": "The slug of the page's previous sibling"
    },
    "nextSlug": {
      "type": ["string", "null"],
      "description": "The slug of the page's next sibling"
    }
  },
  "required": ["title"],
  "claroline": {
    "ids":  ["id"]
  }
}
